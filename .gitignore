# --------------------------------------------------------------------
# ClinixPro — git ignore rules
# --------------------------------------------------------------------

# Python bytecode + caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets / runtime config (.env.example IS tracked)
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Local data fallbacks / mock dumps
backend/_mock_data_dump.json
backend/uploads_local/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Node (if used for tooling)
node_modules/
dist/
build/

# Coverage / test artifacts
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
